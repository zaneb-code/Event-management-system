# ------------------------------------------------------------------
# Copy this file to a new file named ".env" and paste your own key in.
#
#   cp .env.example .env
#
# Get a free key at https://developer.ticketmaster.com/
# (after signing up, the key you need is called "Consumer Key")
#
# Vite only exposes variables that start with VITE_ to the browser.
# The real .env file is listed in .gitignore so it is never committed.
# ------------------------------------------------------------------

VITE_TICKETMASTER_API_KEY=your_consumer_key_here
